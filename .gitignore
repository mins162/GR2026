# OS
.DS_Store
**/.DS_Store

# 빌드 산출물 (nvcc/g++ 결과 — 소스에서 재생성)
run/InstantGR
run/InstantGR.*
baseline/run/InstantGR
baseline/run/InstantGR.*
*.o

# 실행 결과 (라우팅 출력 / 로그 / 프로파일)
*.out
*.log
run/*.eval
run/logs*/
baseline/run/*.eval
rsmt_depth_profile.csv

# A/B 스크립트가 만드는 결과 디렉터리
ab_results_*/

# nsys 프로파일 결과 (트레이스는 수백 MB ~ GB)
nsys_results_*/
*.nsys-rep
*.qdrep
*.sqlite

# 에디터
.vscode/
.idea/
*.swp

# 벤치마크 입력 (Google Drive에서 별도 다운로드, 수백 MB~GB)
benchmarks/

# 대회 서류 · 개인 서버 메모 · 논문 PDF (공개 저장소에 올리지 않음)
